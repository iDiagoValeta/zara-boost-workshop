---
import badgeCheckIcon from "../../assets/badge-check.svg";
import errorIcon from "../../assets/octagon-times-solid.svg";
import ExerciseNav from "../../components/ExerciseNav.astro";
import Layout from "../../layouts/Layout.astro";
import { product, targetLocales } from "../../exercise/01-our-first-query";

const badgeCheckIconSrc =
	typeof badgeCheckIcon === "string" ? badgeCheckIcon : badgeCheckIcon.src;
const errorIconSrc = typeof errorIcon === "string" ? errorIcon : errorIcon.src;
---

<Layout
	title="Exercise 01 · OpenAI Validator"
	description="Validate and preview the localized product copy returned by the first OpenAI exercise."
>
	<div class="relative min-h-screen overflow-hidden">
		<div
			class="pointer-events-none absolute inset-0 -z-10 opacity-[0.04]"
			style="background-image:linear-gradient(var(--color-line) 1px,transparent 1px),linear-gradient(90deg,var(--color-line) 1px,transparent 1px);background-size:64px 64px;"
		>
		</div>

		<header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
			<a href="/" class="flex items-center gap-3">
				<img src="/logo.svg" alt="Zara" width="74" height="31" class="h-6 w-auto" />
				<span class="text-line text-2xl leading-none">/</span>
				<span class="font-mono text-xs tracking-[0.35em] text-muted uppercase">Boost</span>
			</a>
			<a
				href="/"
				class="border-line rounded-full border px-4 py-2 font-mono text-xs tracking-[0.16em] text-muted uppercase transition hover:bg-surface-2 hover:text-paper"
			>
				Back
			</a>
		</header>

		<main class="mx-auto max-w-6xl px-6 pb-24">
			<section class="border-line border-y py-14 sm:py-20">
				<p class="font-mono text-xs tracking-[0.24em] text-muted uppercase">Exercise 01</p>
				<h1 class="font-pixel mt-5 text-4xl leading-none text-paper sm:text-6xl">
					OpenAI<br />Result Check
				</h1>
				<p class="mt-6 max-w-2xl font-mono text-sm leading-relaxed text-muted sm:text-base">
					This page runs <span class="text-paper">src/exercise/01-our-first-query.ts</span>,
					validates the JSON returned by the model and renders the product copy for every
					expected locale.
				</p>
			</section>

			<section class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-[0.9fr_1.1fr] mt-10">
				<article class="bg-surface p-6 sm:p-8">
					<div class="overflow-hidden rounded-xl border border-line bg-ink">
						<img
							src={product.image}
							alt={product.name}
							class="aspect-[4/5] w-full object-cover grayscale"
						/>
					</div>
					<div class="mt-6 flex items-start justify-between gap-4">
						<div>
							<p class="font-mono text-xs tracking-[0.18em] text-muted uppercase">
								{product.category}
							</p>
							<h2 class="mt-2 font-mono text-xl font-medium text-paper">{product.name}</h2>
						</div>
						<p class="font-pixel text-xl text-paper">{product.price}</p>
					</div>
					<p class="mt-4 font-mono text-sm leading-relaxed text-muted">{product.material}</p>
					<p class="mt-3 font-mono text-sm leading-relaxed text-muted">
						{product.sourceDescription}
					</p>
				</article>

				<section class="bg-surface p-6 sm:p-8">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<div>
							<p class="font-mono text-xs tracking-[0.24em] text-muted uppercase">
								Expected locales
							</p>
							<p class="mt-2 font-mono text-sm text-paper">{targetLocales.join(" / ")}</p>
						</div>
						<button
							id="run-check"
							class="bg-paper rounded-full px-5 py-3 font-mono text-sm font-medium text-ink transition hover:opacity-80"
						>
							Run check
						</button>
					</div>

					<div
						id="status"
						data-error-icon={errorIconSrc}
						data-success-icon={badgeCheckIconSrc}
						class="mt-6 rounded-2xl border border-line bg-ink p-5 font-mono text-sm text-muted"
					>
						Ready. Click <span class="text-paper">Run check</span> to call OpenAI.
					</div>

					<div id="results" data-target-locales={JSON.stringify(targetLocales)} class="mt-6 grid gap-4"></div>
				</section>
			</section>
		</main>

		<ExerciseNav next={{ href: "/exercise/02", label: "Zara Chatbot Streaming" }} />
	</div>

	<script>
		import type { LocalizedProductCopy } from "../../exercise/01-our-first-query";

		type AssistantMessage = {
			content?: string | null;
			reasoning_details?: unknown;
		};

		type LocalizedResult = {
			copies: LocalizedProductCopy[];
		};

		const button = document.querySelector<HTMLButtonElement>("#run-check");
		const status = document.querySelector<HTMLElement>("#status");
		const results = document.querySelector<HTMLElement>("#results");
		const targetLocales = JSON.parse(
			results?.dataset.targetLocales ?? "[]",
		) as LocalizedProductCopy["locale"][];

		const createStatusIcon = (src: string) => {
			const img = document.createElement("img");
			img.src = src;
			img.alt = "";
			img.setAttribute("aria-hidden", "true");

			return img;
		};

		const setIconStatus = (message: string, className: string, iconSrc: string) => {
			if (!status) return;
			const text = document.createElement("span");
			text.textContent = message;

			status.className = className;
			status.replaceChildren(createStatusIcon(iconSrc), text);
		};

		const setStatus = (message: string, type: "idle" | "success" | "error" = "idle") => {
			if (!status) return;
			const baseClass = "mt-6 rounded-2xl border bg-ink p-5 font-mono text-sm";

			if (type === "success") {
				setIconStatus(
					message,
					`${baseClass} exercise-status-success flex items-start gap-3`,
					status.dataset.successIcon ?? "",
				);
				return;
			}

			if (type === "error") {
				setIconStatus(
					message,
					`${baseClass} exercise-status-error flex items-start gap-3`,
					status.dataset.errorIcon ?? "",
				);
				return;
			}

			status.className = `${baseClass} border-line text-muted`;
			status.textContent = message;
		};

		const stripCodeFence = (content: string) =>
			content
				.trim()
				.replace(/^```(?:json)?\s*/i, "")
				.replace(/\s*```$/i, "");

		const escapeHtml = (value: string) =>
			value
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");

		const parseAssistantContent = (message: AssistantMessage): LocalizedResult => {
			if (!message.content) {
				throw new Error("The assistant response does not include content.");
			}

			const parsed = JSON.parse(stripCodeFence(message.content)) as LocalizedResult;

			if (!Array.isArray(parsed.copies)) {
				throw new Error('The JSON must include a "copies" array.');
			}

			for (const locale of targetLocales) {
				const copy = parsed.copies.find((item) => item.locale === locale);

				if (!copy) {
					throw new Error(`Missing locale: ${locale}`);
				}

				if (!copy.title || !copy.shortDescription || !Array.isArray(copy.tags)) {
					throw new Error(`Invalid copy shape for locale: ${locale}`);
				}
			}

			return parsed;
		};

		const getAssistantMessage = async (): Promise<AssistantMessage> => {
			const response = await fetch("/api/exercise/01", { method: "POST" });
			const payload = (await response.json()) as AssistantMessage & { error?: string };

			if (!response.ok) {
				throw new Error(payload.error ?? "The server request failed.");
			}

			return payload;
		};

		const renderCopies = (copies: LocalizedProductCopy[]) => {
			if (!results) return;

			results.innerHTML = copies
				.map(
					(copy) => `
						<article class="rounded-2xl border border-line bg-ink p-5">
							<div class="flex items-center justify-between gap-4">
								<span class="font-pixel text-2xl text-paper">${escapeHtml(copy.locale.toUpperCase())}</span>
								<span class="font-mono text-xs tracking-[0.2em] text-muted uppercase">locale</span>
							</div>
							<h3 class="mt-4 font-mono text-lg font-medium text-paper">${escapeHtml(copy.title)}</h3>
							<p class="mt-3 font-mono text-sm leading-relaxed text-muted">${escapeHtml(copy.shortDescription)}</p>
							<div class="mt-5 flex flex-wrap gap-2">
								${copy.tags
									.map(
										(tag) =>
											`<span class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">${escapeHtml(tag)}</span>`,
									)
									.join("")}
							</div>
						</article>
					`,
				)
				.join("");
		};

		button?.addEventListener("click", async () => {
			if (!button) return;

			button.disabled = true;
			button.textContent = "Checking...";
			results?.replaceChildren();
			setStatus("Calling OpenAI and validating the assistant response...");

			try {
				const assistantMessage = await getAssistantMessage();
				const result = parseAssistantContent(assistantMessage);

				renderCopies(result.copies);
				setStatus("Exercise looks good. The response is valid JSON and includes every locale.", "success");
			} catch (error) {
				const message = error instanceof Error ? error.message : "Unknown error";
				setStatus(`Exercise failed: ${message}`, "error");
			} finally {
				button.disabled = false;
				button.textContent = "Run check";
			}
		});
	</script>
</Layout>
