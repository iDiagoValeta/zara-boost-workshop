---
import ExerciseNav from "../../components/ExerciseNav.astro";
import Layout from "../../layouts/Layout.astro";
import { garment } from "../../exercise/03-virtual-try-on";
---

<Layout
	title="Exercise 03 · GPT Image Virtual Try-On"
	description="Upload a person image and use GPT Image 2 to dress them with the Zara garment reference."
>
	<div class="relative min-h-screen overflow-hidden">
		<div
			class="pointer-events-none absolute inset-0 -z-10 opacity-[0.04]"
			style="background-image:linear-gradient(var(--color-line) 1px,transparent 1px),linear-gradient(90deg,var(--color-line) 1px,transparent 1px);background-size:64px 64px;"
		>
		</div>
		<div
			class="pointer-events-none absolute right-[-12rem] top-24 -z-10 h-[520px] w-[520px] rounded-full opacity-15 blur-[120px]"
			style="background:radial-gradient(circle, #f5f5f5, transparent 70%);"
		>
		</div>
		<div
			id="drop-overlay"
			class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-ink/85 p-6 backdrop-blur-sm"
			aria-hidden="true"
		>
			<div class="max-w-lg border border-paper bg-surface p-8 text-center shadow-2xl shadow-black/40">
				<p class="font-pixel text-4xl leading-none text-paper sm:text-5xl">Drop<br />Image</p>
				<p class="mt-5 font-mono text-sm leading-relaxed text-muted">
					Drop a JPG, PNG or WEBP image with a person here. We will use it as the base for
					the virtual try-on.
				</p>
			</div>
		</div>
		<div
			id="image-modal"
			class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/90 p-4 backdrop-blur-sm"
			role="dialog"
			aria-modal="true"
			aria-label="Generated try-on image preview"
		>
			<button
				id="close-image-modal"
				type="button"
				class="absolute right-4 top-4 rounded-full border border-line bg-surface px-4 py-2 font-mono text-xs tracking-[0.16em] text-paper uppercase transition hover:bg-surface-2"
			>
				Close
			</button>
			<img
				id="modal-image"
				alt="Generated virtual try-on large preview"
				class="max-h-[88vh] max-w-[92vw] border border-line bg-surface object-contain shadow-2xl shadow-black/60"
			/>
		</div>

		<header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
			<a href="/" class="flex items-center gap-3">
				<img src="/logo.svg" alt="Zara" width="74" height="31" class="h-6 w-auto" />
				<span class="text-line text-2xl leading-none">/</span>
				<span class="font-mono text-xs tracking-[0.35em] text-muted uppercase">Boost</span>
			</a>
			<a
				href="/"
				class="border-line rounded-full border px-4 py-2 font-mono text-xs tracking-[0.16em] text-muted uppercase transition hover:bg-surface-2 hover:text-paper"
			>
				Back
			</a>
		</header>

		<main class="mx-auto max-w-6xl px-6 pb-24">
			<section class="border-line border-y py-14 sm:py-20">
				<p class="font-mono text-xs tracking-[0.24em] text-muted uppercase">Exercise 03</p>
				<h1 class="font-pixel mt-5 text-4xl leading-none text-paper sm:text-6xl">
					GPT Image<br />Virtual Try-On
				</h1>
				<p class="mt-6 max-w-2xl font-mono text-sm leading-relaxed text-muted sm:text-base">
					This page runs <span class="text-paper">src/exercise/03-virtual-try-on.ts</span>.
					Upload a person image and use <span class="text-paper">gpt-image-2</span> to apply
					the Zara garment reference without changing the person.
				</p>
			</section>

			<section
				class="mt-10 grid gap-px overflow-hidden border border-line bg-line lg:grid-cols-[0.85fr_1.15fr]"
			>
				<article class="bg-surface p-6 sm:p-8">
					<p class="font-mono text-xs tracking-[0.24em] text-muted uppercase">Garment reference</p>
					<div class="mt-5 overflow-hidden border border-line bg-ink">
						<img src={garment.image} alt={garment.name} class="aspect-[4/5] w-full object-cover" />
					</div>

					<div class="mt-6">
						<p class="font-mono text-xs tracking-[0.18em] text-muted uppercase">{garment.category}</p>
						<h2 class="mt-2 font-mono text-xl font-medium text-paper">{garment.name}</h2>
						<p class="mt-3 font-mono text-sm leading-relaxed text-muted">{garment.material}</p>
					</div>

					<div class="mt-6 border border-line bg-ink p-5">
						<p class="font-mono text-xs tracking-[0.2em] text-muted uppercase">Challenge TODOs</p>
						<ul class="mt-4 space-y-3 font-mono text-sm text-muted">
							<li class="flex gap-3">
								<span class="text-paper">→</span> Write a precise virtual try-on prompt
							</li>
							<li class="flex gap-3">
								<span class="text-paper">→</span> Send both images to the edit endpoint
							</li>
							<li class="flex gap-3">
								<span class="text-paper">→</span> Return the generated image safely
							</li>
						</ul>
					</div>
				</article>

				<section class="bg-surface p-6 sm:p-8">
					<div class="flex flex-wrap items-start justify-between gap-4">
						<div>
							<p class="font-mono text-xs tracking-[0.24em] text-muted uppercase">Try-on studio</p>
							<h2 class="mt-2 font-mono text-xl font-medium text-paper">Dress the uploaded person</h2>
						</div>
						<div
							id="status"
							class="rounded-full border border-line bg-ink px-4 py-2 font-mono text-xs text-muted"
						>
							Waiting for upload
						</div>
					</div>

					<form id="try-on-form" class="mt-6 grid gap-5">
						<div>
							<label
								for="personImage"
								class="block font-mono text-xs tracking-[0.2em] text-muted uppercase"
							>
								Person image
							</label>
							<input
								id="personImage"
								name="personImage"
								type="file"
								accept="image/png,image/jpeg,image/webp"
								class="mt-3 w-full border border-line bg-ink p-4 font-mono text-sm text-muted file:mr-4 file:rounded-full file:border-0 file:bg-paper file:px-4 file:py-2 file:font-mono file:text-sm file:text-ink"
							/>
							<p class="mt-2 font-mono text-xs leading-relaxed text-muted">
								Use a clear JPG, PNG or WEBP image under 50MB. You can also drag and drop it anywhere on this page.
							</p>
						</div>

						<div>
							<label for="notes" class="block font-mono text-xs tracking-[0.2em] text-muted uppercase">
								Optional fit notes
							</label>
							<textarea
								id="notes"
								name="notes"
								rows="3"
								maxlength="500"
								placeholder="Example: keep the shirt relaxed, sleeves slightly rolled..."
								class="mt-3 w-full resize-none border border-line bg-ink px-5 py-4 font-mono text-sm text-paper outline-none transition placeholder:text-muted focus:border-paper"
							></textarea>
						</div>

						<button
							id="generate-button"
							type="submit"
							class="bg-paper rounded-full px-6 py-3 font-mono text-sm font-medium text-ink transition hover:opacity-80 disabled:cursor-not-allowed disabled:opacity-50"
						>
							Generate try-on
						</button>
					</form>

					<div class="mt-8 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2">
						<article class="bg-ink p-4">
							<div class="flex items-center justify-between gap-4">
								<p class="font-mono text-xs tracking-[0.2em] text-muted uppercase">Uploaded person</p>
								<span class="font-pixel text-xl text-paper">01</span>
							</div>
							<div class="mt-4 flex aspect-[4/5] items-center justify-center overflow-hidden border border-line bg-surface">
								<img id="person-preview" alt="Uploaded person preview" class="hidden h-full w-full object-cover" />
								<p id="person-empty" class="px-6 text-center font-mono text-sm leading-relaxed text-muted">
									Upload a person image to preview it here.
								</p>
							</div>
						</article>

						<article class="bg-ink p-4">
							<div class="flex items-center justify-between gap-4">
								<p class="font-mono text-xs tracking-[0.2em] text-muted uppercase">Generated try-on</p>
								<span class="font-pixel text-xl text-paper">02</span>
							</div>
							<button
								id="zoom-result"
								type="button"
								class="mt-4 flex aspect-[4/5] w-full items-center justify-center overflow-hidden border border-line bg-surface text-left transition disabled:cursor-default disabled:hover:border-line enabled:cursor-zoom-in enabled:hover:border-paper"
								disabled
								aria-label="Open generated try-on image preview"
							>
								<img id="result-image" alt="Generated virtual try-on" class="hidden h-full w-full object-cover" />
								<p id="result-empty" class="px-6 text-center font-mono text-sm leading-relaxed text-muted">
									The GPT Image result will appear here.
								</p>
								<div
									id="result-loading"
									class="try-on-skeleton hidden h-full w-full"
									aria-live="polite"
								>
								</div>
							</button>
							<p id="zoom-hint" class="mt-3 hidden font-mono text-xs text-muted">
								Click the generated image to preview it larger.
							</p>
						</article>
					</div>

					<p id="revised-prompt" class="mt-5 hidden border border-line bg-ink p-5 font-mono text-xs leading-relaxed text-muted"></p>
				</section>
			</section>
		</main>

		<ExerciseNav
			prev={{ href: "/exercise/02", label: "Zara Chatbot Streaming" }}
			next={{ href: "/exercise/04", label: "AGENTS.md Coding Rules" }}
		/>
	</div>

	<script>
		type TryOnResponse = {
			imageSrc?: string;
			revisedPrompt?: string | null;
			error?: string;
		};

		const form = document.querySelector<HTMLFormElement>("#try-on-form");
		const fileInput = document.querySelector<HTMLInputElement>("#personImage");
		const button = document.querySelector<HTMLButtonElement>("#generate-button");
		const status = document.querySelector<HTMLElement>("#status");
		const personPreview = document.querySelector<HTMLImageElement>("#person-preview");
		const personEmpty = document.querySelector<HTMLElement>("#person-empty");
		const resultImage = document.querySelector<HTMLImageElement>("#result-image");
		const resultEmpty = document.querySelector<HTMLElement>("#result-empty");
		const resultLoading = document.querySelector<HTMLElement>("#result-loading");
		const revisedPrompt = document.querySelector<HTMLElement>("#revised-prompt");
		const dropOverlay = document.querySelector<HTMLElement>("#drop-overlay");
		const zoomTrigger = document.querySelector<HTMLButtonElement>("#zoom-result");
		const zoomHint = document.querySelector<HTMLElement>("#zoom-hint");
		const imageModal = document.querySelector<HTMLElement>("#image-modal");
		const modalImage = document.querySelector<HTMLImageElement>("#modal-image");
		const closeImageModal = document.querySelector<HTMLButtonElement>("#close-image-modal");
		const supportedTypes = new Set(["image/jpeg", "image/png", "image/webp"]);
		let previewUrl: string | null = null;
		let selectedPersonFile: File | null = null;
		let dragDepth = 0;

		const setStatus = (message: string, tone: "idle" | "loading" | "success" | "error" = "idle") => {
			if (!status) return;

			const tones = {
				idle: "border-line text-muted",
				loading: "border-sky-300/40 text-sky-200",
				success: "border-green-300/50 text-green-200",
				error: "border-red-300/50 text-red-200",
			};

			status.className = `rounded-full border bg-ink px-4 py-2 font-mono text-xs ${tones[tone]}`;
			status.textContent = message;
		};

		const setBusy = (busy: boolean) => {
			if (!button || !fileInput) return;

			button.disabled = busy;
			fileInput.disabled = busy;
			button.textContent = busy ? "Generating..." : "Generate try-on";
		};

		const clearResult = () => {
			if (resultImage) {
				resultImage.removeAttribute("src");
				resultImage.classList.add("hidden");
			}

			resultEmpty?.classList.remove("hidden");
			resultLoading?.classList.add("hidden");
			revisedPrompt?.classList.add("hidden");
			zoomHint?.classList.add("hidden");

			if (zoomTrigger) {
				zoomTrigger.disabled = true;
			}

			if (modalImage) {
				modalImage.removeAttribute("src");
			}
		};

		const setResultLoading = (loading: boolean) => {
			if (loading) {
				resultEmpty?.classList.add("hidden");
				resultLoading?.classList.remove("hidden");
				return;
			}

			resultLoading?.classList.add("hidden");
		};

		const isFileDrag = (event: DragEvent) => event.dataTransfer?.types.includes("Files") ?? false;

		const showDropOverlay = () => {
			dropOverlay?.classList.remove("hidden");
			dropOverlay?.classList.add("flex");
		};

		const hideDropOverlay = () => {
			dragDepth = 0;
			dropOverlay?.classList.add("hidden");
			dropOverlay?.classList.remove("flex");
		};

		const showPersonPreview = (file: File) => {
			if (!personPreview || !personEmpty) return;

			if (previewUrl) {
				URL.revokeObjectURL(previewUrl);
			}

			previewUrl = URL.createObjectURL(file);
			personPreview.src = previewUrl;
			personPreview.classList.remove("hidden");
			personEmpty.classList.add("hidden");
		};

		const openImageModal = () => {
			if (!imageModal || !modalImage || !resultImage?.src) return;

			modalImage.src = resultImage.src;
			imageModal.classList.remove("hidden");
			imageModal.classList.add("flex");
			document.body.style.overflow = "hidden";
			closeImageModal?.focus();
		};

		const closeModal = () => {
			if (!imageModal) return;

			imageModal.classList.add("hidden");
			imageModal.classList.remove("flex");
			document.body.style.overflow = "";
			zoomTrigger?.focus();
		};

		const selectPersonImage = (file: File) => {
			clearResult();

			if (!supportedTypes.has(file.type)) {
				setStatus("Use JPG, PNG or WEBP", "error");
				return;
			}

			selectedPersonFile = file;
			showPersonPreview(file);
			setStatus("Ready to generate", "idle");
		};

		fileInput?.addEventListener("change", () => {
			const file = fileInput.files?.[0];
			clearResult();

			if (!file) {
				selectedPersonFile = null;
				setStatus("Waiting for upload");
				return;
			}

			selectPersonImage(file);
		});

		document.addEventListener("dragenter", (event) => {
			if (!isFileDrag(event)) return;

			event.preventDefault();
			dragDepth += 1;
			showDropOverlay();
			setStatus("Drop the person image anywhere", "loading");
		});

		document.addEventListener("dragover", (event) => {
			if (!isFileDrag(event)) return;

			event.preventDefault();

			if (event.dataTransfer) {
				event.dataTransfer.dropEffect = "copy";
			}
		});

		document.addEventListener("dragleave", (event) => {
			if (!isFileDrag(event)) return;

			event.preventDefault();
			dragDepth -= 1;

			if (dragDepth <= 0) {
				hideDropOverlay();
				setStatus(selectedPersonFile ? "Ready to generate" : "Waiting for upload");
			}
		});

		document.addEventListener("drop", (event) => {
			if (!isFileDrag(event)) return;

			event.preventDefault();
			hideDropOverlay();

			if (button?.disabled) {
				setStatus("Wait until generation finishes", "loading");
				return;
			}

			const file = event.dataTransfer?.files[0];

			if (!file) {
				setStatus("Drop an image file", "error");
				return;
			}

			selectPersonImage(file);
		});

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (!form || !fileInput) return;

			const file = selectedPersonFile ?? fileInput.files?.[0];

			if (!file) {
				setStatus("Upload a person image first", "error");
				return;
			}

			clearResult();
			setBusy(true);
			setResultLoading(true);
			setStatus("Calling GPT Image...", "loading");

			try {
				const formData = new FormData(form);
				formData.set("personImage", file);

				const response = await fetch("/api/exercise/03", {
					method: "POST",
					body: formData,
				});
				const payload = (await response.json()) as TryOnResponse;

				if (!response.ok) {
					throw new Error(payload.error ?? "The server request failed.");
				}

				if (!payload.imageSrc) {
					throw new Error("The response did not include an image.");
				}

				if (resultImage) {
					resultImage.src = payload.imageSrc;
					resultImage.classList.remove("hidden");
				}

				resultEmpty?.classList.add("hidden");
				setResultLoading(false);
				zoomHint?.classList.remove("hidden");

				if (zoomTrigger) {
					zoomTrigger.disabled = false;
				}

				if (payload.revisedPrompt && revisedPrompt) {
					revisedPrompt.textContent = `Model prompt note: ${payload.revisedPrompt}`;
					revisedPrompt.classList.remove("hidden");
				}

				setStatus("Try-on generated", "success");
			} catch (error) {
				const message = error instanceof Error ? error.message : "Unknown error";
				setResultLoading(false);
				resultEmpty?.classList.remove("hidden");
				setStatus(`Exercise failed: ${message}`, "error");
			} finally {
				setBusy(false);
			}
		});

		zoomTrigger?.addEventListener("click", openImageModal);
		closeImageModal?.addEventListener("click", closeModal);

		imageModal?.addEventListener("click", (event) => {
			if (event.target === imageModal) {
				closeModal();
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && !imageModal?.classList.contains("hidden")) {
				closeModal();
			}
		});
	</script>
</Layout>
